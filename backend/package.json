{
  "name": "robert-izak-whatsapp-backend",
  "version": "1.0.0",
  "description": "WhatsApp Business API backend for Robert & Izak Computers Customer Service",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "pm2": "pm2 start server.js --name whatsapp-backend",
    "pm2:stop": "pm2 stop whatsapp-backend",
    "pm2:restart": "pm2 restart whatsapp-backend",
    "pm2:logs": "pm2 logs whatsapp-backend"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "axios": "^1.6.2",
    "@supabase/supabase-js": "^2.38.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "moment": "^2.29.4",
    "body-parser": "^1.20.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}